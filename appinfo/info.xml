<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
  <id>koreader_companion</id>
  <name>KOReader Companion</name>
  <summary>OPDS library and KOReader sync for Nextcloud</summary>
  <description>Transform your Nextcloud into an authenticated OPDS ebook library with full KOReader sync support. Access your ebooks from any OPDS-compatible reader and keep your reading progress synchronized across devices.</description>
  <version>1.4.0</version>
  <licence>AGPL-3.0-or-later</licence>
  <author>Dominik Fischer</author>
  <namespace>KoreaderCompanion</namespace>
  <category>files</category>
  <bugs>https://github.com/international-omelette/nextcloud-koreader-companion/issues</bugs>
  <repository type="git">https://github.com/international-omelette/nextcloud-koreader-companion.git</repository>
  <dependencies>
    <!-- No max-version on php on purpose: NC 34 already runs on 8.5 and pinning
         an upper bound would falsely block a future patch release. -->
    <php min-version="8.2" />
    <nextcloud min-version="34" max-version="34" />
  </dependencies>
  <commands>
    <command>OCA\KoreaderCompanion\Command\GenerateBookHashesCommand</command>
    <command>OCA\KoreaderCompanion\Command\IndexBooksCommand</command>
  </commands>
  <navigations>
    <navigation>
      <name>KOReader</name>
      <route>koreader_companion.page.index</route>
      <icon>icon.svg</icon>
    </navigation>
  </navigations>
</info>
