# Composer dependencies
/vendor/

# Keep composer.lock for dependency reproducibility (Nextcloud best practice)

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log

# Nextcloud specific
/build/
/node_modules/

# Generated sample books for the local dev stack (see dev/seed.sh)
/dev/fixtures/

# AI development tools
.claude/settings.local.json
.playwright-mcp/

certificates
# Vite build output: the bundles are committed (Nextcloud apps ship built JS and
# the app store tarball has no build step), but sourcemaps are not -- they are
# ~8 MB and regenerate from `npm run build`.
/js/*.map
/css/*.map

# Generated at release time by `make sign`; a committed one goes stale immediately.
appinfo/signature.json

# Python bytecode from the dev helper scripts
__pycache__/
